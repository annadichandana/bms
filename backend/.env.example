# ARIA BMS — Environment Configuration
# ======================================
# Copy this file to .env and fill in your values:
#   cp backend/.env.example backend/.env

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Groq API key — Get free at https://console.groq.com
GROQ_API_KEY=your_groq_api_here

# Groq model (tool-calling capable models)
# Options: llama-3.3-70b-versatile | llama-3.1-70b-versatile | mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama local LLM (used as fallback when Groq is not available)
# Start Ollama with: ollama serve
# Pull model with:   ollama pull phi3:mini
OLLAMA_BASE_URL=http://localhost:11434

# ── EnergyPlus Configuration ──────────────────────────────────────────────────
# Path to EnergyPlus installation (enables real co-simulation)
# Download from: https://github.com/NREL/EnergyPlus/releases
# If not set, the system uses the physics-based mock simulator
ENERGYPLUS_DIR=C:\EnergyPlusV24-1-0

# ── Building Configuration ────────────────────────────────────────────────────
# Energy cost (used for dashboard cost calculations)
ENERGY_PRICE_PER_KWH=0.12

# Carbon emission factor (India grid average: 0.485 kg CO2/kWh)
# Source: Central Electricity Authority, India
CARBON_FACTOR_KG_PER_KWH=0.485

# ── Server Configuration ──────────────────────────────────────────────────────
# FastAPI server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Simulation speed multiplier (1.0 = real-time, 10.0 = fast demo)
SIMULATION_SPEED=3.0

# ── Optimization Goals ────────────────────────────────────────────────────────
# Daily energy budget (kWh) — baseline is ~450 kWh/day, target 22%+ reduction
DAILY_ENERGY_BUDGET_KWH=350

# Daily carbon emission limit (kg CO2)
DAILY_CARBON_LIMIT_KG=170

# Comfort bounds (ASHRAE 55 PMV standard)
PMV_MIN=-0.5
PMV_MAX=0.5

# CO2 ppm limit (ASHRAE 62.1 — action taken above 800, alarm at 1000)
CO2_LIMIT_PPM=1000

# ── Frontend ──────────────────────────────────────────────────────────────────
# CORS origins for React frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
